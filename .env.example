# Copier vers .env. Ne jamais commiter .env.
# Identifiant Météo-France, côté serveur uniquement.
METEOFRANCE_APP_ID=

# Zone ingérée : lon_min,lon_max,lat_min,lat_max. Obligatoire. Voir D9.
PIAF_BBOX=2.2,2.5,48.8,48.95

# Développement : arrête l'ingestion après N runs. L'API continue et passe en unknown.
PIAF_MAX_RUNS=1

# 127.0.0.1:8080 par défaut. Sous Windows, ce port peut être réservé par le système.
#BIND_ADDR=127.0.0.1:18787

# Valeurs par défaut, voir docs/02-architecture.md.
#RAIN_THRESHOLD_MM_H=0.1
#MIN_WET_STEPS=2
#MAX_DATA_AGE_MIN=20
